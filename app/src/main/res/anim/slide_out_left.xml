<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/anim/slide_out_left.xml
     Ecrã ANTIGO a sair por baixo, deslizando ligeiramente para a esquerda
     com um leve escurecimento (efeito parallax) — companheiro de
     slide_in_right, imita o push do iOS onde o ecrã anterior "recua". -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <translate
        android:fromXDelta="0%p"
        android:toXDelta="-28%p"
        android:duration="320"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.85"
        android:duration="320"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>