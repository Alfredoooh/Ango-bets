<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Aplicados via activity.setTheme() dinamicamente, ANTES do
         setContentView, de acordo com ThemePreference.resolveIsDark().
         Assim os DatePickerDialog/TimePickerDialog nativos (disparados
         automaticamente pelo WebView para <input type="date"> /
         <input type="time">) seguem o tema do PWA — não o do sistema —
         com a paleta Fluent 2 em vez do Material padrão. -->

    <style name="Theme.Nexa.FluentPickers.Light" parent="Theme.Nexa">
        <item name="android:datePickerDialogTheme">@style/Fluent.DatePickerDialog.Light</item>
        <item name="android:timePickerDialogTheme">@style/Fluent.TimePickerDialog.Light</item>
    </style>

    <style name="Theme.Nexa.FluentPickers.Dark" parent="Theme.Nexa">
        <item name="android:datePickerDialogTheme">@style/Fluent.DatePickerDialog.Dark</item>
        <item name="android:timePickerDialogTheme">@style/Fluent.TimePickerDialog.Dark</item>
    </style>

    <style name="Fluent.DatePickerDialog.Light" parent="android:Theme.DeviceDefault.Light.Dialog">
        <item name="android:colorAccent">#0067C0</item>
        <item name="android:textColorPrimary">#1B1B1B</item>
        <item name="android:windowBackground">@drawable/fluent_dialog_bg</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Fluent.Picker.Button</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Fluent.Picker.Button</item>
    </style>

    <style name="Fluent.TimePickerDialog.Light" parent="android:Theme.DeviceDefault.Light.Dialog">
        <item name="android:colorAccent">#0067C0</item>
        <item name="android:textColorPrimary">#1B1B1B</item>
        <item name="android:windowBackground">@drawable/fluent_dialog_bg</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Fluent.Picker.Button</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Fluent.Picker.Button</item>
    </style>

    <style name="Fluent.DatePickerDialog.Dark" parent="android:Theme.DeviceDefault.Dialog">
        <item name="android:colorAccent">#4CC2FF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:windowBackground">@drawable/fluent_dialog_bg_dark</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Fluent.Picker.Button.Dark</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Fluent.Picker.Button.Dark</item>
    </style>

    <style name="Fluent.TimePickerDialog.Dark" parent="android:Theme.DeviceDefault.Dialog">
        <item name="android:colorAccent">#4CC2FF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:windowBackground">@drawable/fluent_dialog_bg_dark</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Fluent.Picker.Button.Dark</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Fluent.Picker.Button.Dark</item>
    </style>

    <style name="Fluent.Picker.Button" parent="android:Widget.DeviceDefault.Button.Borderless">
        <item name="android:textColor">#0067C0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Fluent.Picker.Button.Dark" parent="android:Widget.DeviceDefault.Button.Borderless">
        <item name="android:textColor">#4CC2FF</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>