<!-- app/src/main/res/values/themes.xml -->
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nexa" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!--
        Splash nativo do sistema (mostrado por Theme.SplashScreen antes
        de qualquer código Kotlin correr, referenciado por
        MainActivity no AndroidManifest.xml). Este ficheiro (values/,
        sem qualifier) é o usado quando o SISTEMA está em modo claro.
        A variante para modo escuro está em values-night/themes.xml,
        com o mesmo nome de style — o Android escolhe automaticamente
        qual dos dois aplicar, sem necessidade de nenhum código extra
        para detetar o tema aqui.
    -->
    <style name="Theme.Nexa.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Nexa</item>
    </style>
</resources>