<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/drawable/bg_input_pill.xml
     radius 100dp garante 100% de arredondamento (pill total) em qualquer
     altura de input razoável, já que o Android limita o raio ao mínimo
     entre o valor pedido e metade da menor dimensão da view. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/auth_input_fill" />
    <corners android:radius="100dp" />
</shape>