<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@color/toolbar_bg"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/btnBold"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_settings_row"
            android:contentDescription="@string/editor_bold" />

        <ImageView
            android:id="@+id/btnItalic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="9dp"
            android:background="@drawable/bg_settings_row"
            android:contentDescription="@string/editor_italic" />

        <ImageView
            android:id="@+id/btnUnderline"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="9dp"
            android:background="@drawable/bg_settings_row"
            android:contentDescription="@string/editor_underline" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/toolbar_divider" />

        <ImageView
            android:id="@+id/btnColor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_settings_row"
            android:contentDescription="@string/editor_color" />

        <ImageView
            android:id="@+id/btnTable"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="9dp"
            android:background="@drawable/bg_settings_row"
            android:contentDescription="@string/editor_table" />

        <ImageView
            android:id="@+id/btnImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="9dp"
            android:background="@drawable/bg_settings_row"
            android:contentDescription="@string/editor_image" />

    </LinearLayout>

</HorizontalScrollView>