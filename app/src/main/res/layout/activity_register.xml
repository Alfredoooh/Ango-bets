<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/layout/activity_register.xml -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/registerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/app_background">

    <!-- Seta de voltar no topo, estilo iOS/Material, para retroceder
         sempre ao ecrã de Login sem depender só do gesto/botão físico -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_back_button"
        android:src="@drawable/ic_back"
        android:padding="8dp"
        android:contentDescription="@string/action_back"
        android:elevation="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp"
            android:paddingTop="96dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/logo"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/register_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/drawer_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/register_subtitle"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/nameEditText"
                style="@style/PlainAuthInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="36dp"
                android:paddingHorizontal="22dp"
                android:hint="@string/hint_name"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/drawer_text"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:imeOptions="actionNext" />

            <TextView
                android:id="@+id/nameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="20dp"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/emailEditText"
                style="@style/PlainAuthInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:paddingHorizontal="22dp"
                android:hint="@string/hint_email"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/drawer_text"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:imeOptions="actionNext" />

            <TextView
                android:id="@+id/emailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="20dp"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/passwordEditText"
                style="@style/PlainAuthInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:paddingHorizontal="22dp"
                android:hint="@string/hint_password"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/drawer_text"
                android:inputType="textPassword"
                android:maxLines="1"
                android:imeOptions="actionDone" />

            <TextView
                android:id="@+id/passwordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="20dp"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="64dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp">

                <Button
                    android:id="@+id/registerButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_btn_primary"
                    android:text="@string/action_register"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null" />

                <com.nexa.app.widgets.GradientRingLoader
                    android:id="@+id/registerProgress"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_has_account"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/loginLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/action_login"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <FrameLayout
        android:id="@+id/snackbarContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>